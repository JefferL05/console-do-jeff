---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, url } from '@utils/index';
import ArticleImage from '@components/ArticleImage.astro';
import PostCard from '@components/PostCard.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.data.sameDayOrder - a.data.sameDayOrder || a.id.localeCompare(b.id));
const featured = posts[0];
const sections = [
  { id: 'projetos', title: 'Projetos na prática', description: 'Aplicações e jogos: da ideia às decisões de implementação.', posts: posts.filter(p => p.data.category === 'Projetos'), href: '/projetos' },
  { id: 'tutoriais', title: 'Tutoriais', description: 'Guias para aprender e experimentar com código.', posts: posts.filter(p => ['React', 'TypeScript'].includes(p.data.category)), href: '/blog' },
  { id: 'ia', title: 'IA no desenvolvimento', description: 'Uso prático, limitações e verificação de resultados.', posts: posts.filter(p => p.data.category === 'IA'), href: '/categories/ia' }
];
---
<BaseLayout title="Console do Jeff | Projetos, código e aprendizados" description="Projetos, tutoriais e uso de IA no desenvolvimento de software por Jefferson Lopes.">
  <div class="home-shell">
    <header class="home-intro"><p class="eyebrow">DESENVOLVENDO E COMPARTILHANDO</p><h1>Console do Jeff</h1><p>Projetos, código e aprendizados de Jefferson Lopes. Compartilho como construo aplicações web, resolvo problemas e uso IA no desenvolvimento.</p>
      <nav class="topic-links" aria-label="Explorar assuntos"><a href="#projetos">Projetos</a><a href="#tutoriais">Tutoriais</a><a href="#ia">IA</a><a href={url('/sobre')}>Sobre mim</a></nav>
    </header>
    {featured && <section class="featured" aria-labelledby="featured-title">
      <div><p class="eyebrow">PUBLICAÇÃO MAIS RECENTE</p><h2 id="featured-title"><a href={url(`/blog/${featured.id}`)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time><a class="action-link" href={url(`/blog/${featured.id}`)}>Ler artigo →</a></div>
      {featured.data.image && <ArticleImage src={featured.data.image.url} alt={featured.data.image.alt} priority class="featured-cover" sizes="(max-width: 768px) 100vw, 500px" />}
    </section>}
    {sections.map(section => <section id={section.id} class="topic-section" aria-labelledby={`${section.id}-title`}>
      <div class="section-heading"><div><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.description}</p></div><a href={url(section.href)}>Explorar →</a></div>
      <div class="post-grid">{section.posts.slice(0, 3).map(post => <PostCard post={post} />)}</div>
    </section>)}
    <aside class="home-follow"><h2>Acompanhe as próximas publicações</h2><p>Novos projetos e aprendizados, disponíveis no seu leitor de RSS.</p><a class="action-link" href={url('/rss.xml')}>Assinar o RSS</a><a href={url('/archive')}>Ver o arquivo completo →</a></aside>
  </div>
</BaseLayout>
<style>
  .home-shell { max-width: 1152px; margin: auto; padding: 44px 24px; }
  .home-intro { max-width: 760px; margin-bottom: 40px; }
  h1 { font-size: clamp(36px,6vw,58px); font-weight: 800; letter-spacing: -.04em; margin: 12px 0; }
  p { line-height: 1.7; }
  .eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .13em; }
  .topic-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .topic-links a, .action-link { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border: 1px solid #8885; border-radius: 10px; font-weight: 600; }
  .featured { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; border: 1px solid #8884; border-radius: 20px; padding: 32px; background: #0f766e0d; align-items: center; }
  .featured h2 { font-size: clamp(24px,3vw,34px); line-height: 1.25; font-weight: 750; margin: 12px 0; }
  .featured time { display: block; margin: 18px 0; font-size: 13px; }
  .featured :global(.featured-cover) { border-radius: 12px; width: 100%; height: auto; }
  .topic-section { margin-top: 56px; scroll-margin-top: 140px; }
  .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 22px; }
  h2 { font-size: 26px; font-weight: 700; }
  .section-heading p { font-size: 14px; margin-top: 6px; }
  .section-heading > a { white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
  .post-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .home-follow { margin-top: 48px; padding: 28px; border: 1px solid #8884; border-radius: 16px; }
  .home-follow a { margin: 16px 16px 0 0; }
  a:hover { text-decoration: underline; }
  @media(max-width:900px) { .post-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width:640px) { .home-shell { padding: 28px 16px; } .featured, .post-grid { grid-template-columns: 1fr; } .featured { padding: 22px; } .section-heading { flex-wrap: wrap; } }
</style>
