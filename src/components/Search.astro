<div class="relative min-w-0">
  <label for="search-input" class="sr-only">Pesquisar artigos</label>
  <input
    type="search"
    id="search-input"
    placeholder="Pesquisar..."
    autocomplete="off"
    aria-controls="search-results"
    class="w-32 sm:w-48 lg:w-64 px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
  />
  <div id="search-results" hidden class="absolute top-full right-0 mt-2 w-64 max-w-[calc(100vw-2rem)] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl max-h-96 overflow-y-auto z-50"></div>
  <span id="search-status" role="status" class="sr-only"></span>
</div>

<script>
  import type Fuse from 'fuse.js';

  interface Post {
    slug: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
  }

  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = document.querySelector<HTMLDivElement>('#search-results');
  const status = document.querySelector<HTMLElement>('#search-status');
  let loading: Promise<Fuse<Post>> | undefined;
  let request = 0;

  function loadIndex() {
    if (!loading) {
      loading = Promise.all([
        fetch(`${import.meta.env.BASE_URL}search-index.json`).then(response => {
          if (!response.ok) throw new Error('Índice indisponível');
          return response.json() as Promise<Post[]>;
        }),
        import('fuse.js')
      ]).then(([posts, { default: Fuse }]) => new Fuse(posts, {
        keys: ['title', 'description', 'category', 'tags'],
        threshold: 0.3
      })).catch(error => {
        loading = undefined;
        throw error;
      });
    }
    return loading;
  }

  function closeResults() {
    request++;
    if (results) results.hidden = true;
    if (status) status.textContent = '';
  }

  async function search() {
    if (!input || !results || !status) return;
    const query = input.value.trim();
    const current = ++request;
    if (query.length < 2) {
      closeResults();
      return;
    }
    results.hidden = false;
    results.textContent = 'Carregando...';
    status.textContent = 'Carregando busca.';
    try {
      const fuse = await loadIndex();
      if (current !== request) return;
      const matches = fuse.search(query).slice(0, 10);
      results.replaceChildren();
      status.textContent = `${matches.length} resultados encontrados.`;
      if (!matches.length) results.textContent = 'Nenhum resultado encontrado.';
      for (const { item } of matches) {
        const link = document.createElement('a');
        link.href = `${import.meta.env.BASE_URL}blog/${encodeURIComponent(item.slug)}/`;
        link.className = 'block p-4 hover:bg-gray-100 dark:hover:bg-gray-700 focus:bg-gray-100 dark:focus:bg-gray-700 border-b border-gray-200 dark:border-gray-700';
        const title = document.createElement('strong');
        title.textContent = item.title;
        const description = document.createElement('p');
        description.className = 'text-sm text-gray-500 dark:text-gray-400 mt-1';
        description.textContent = item.description;
        link.append(title, description);
        results.append(link);
      }
    } catch {
      if (current !== request) return;
      results.textContent = 'Busca indisponível. Digite novamente para tentar.';
      status.textContent = results.textContent;
    }
  }

  input?.addEventListener('focus', () => {
    if (input.value.trim().length >= 2) void search();
    else void loadIndex().catch(() => {});
  });
  input?.addEventListener('input', () => void search());
  input?.parentElement?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      closeResults();
      if (document.activeElement !== input) input?.focus();
      closeResults();
    }
    if (event.key === 'ArrowDown' && document.activeElement === input && results && !results.hidden) {
      const first = results.querySelector('a');
      if (first) { event.preventDefault(); first.focus(); }
    }
  });
  document.addEventListener('click', event => {
    if (!input?.parentElement?.contains(event.target as Node)) closeResults();
  });
</script>
