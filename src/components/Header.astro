---
import { url } from '@utils/index';
import Search from './Search.astro';

const navItems = [
  { href: url('/'), label: 'Início' },
  { href: url('/blog'), label: 'Blog' },
  { href: url('/archive'), label: 'Arquivo' },
  { href: url('/categories'), label: 'Categorias' },
  { href: url('/projetos'), label: 'Projetos' },
  { href: url('/sobre'), label: 'Sobre' }
];

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navegação principal">
    <div class="header-row">
      <a href={navItems[0].href} class="brand-link" aria-label="Console do Jeff — início">
        <span class="text-2xl">&lt;/&gt;</span>
        <span class="brand-name">Console do Jeff</span>
      </a>
      
      <div class="desktop-links">
        {navItems.filter(item => ['Sobre', 'Arquivo', 'Projetos'].includes(item.label)).map(item => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-primary-600 dark:hover:text-primary-400',
              currentPath === item.href 
                ? 'text-primary-600 dark:text-primary-400' 
                : 'text-gray-600 dark:text-gray-400'
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
      
      <div class="header-tools">
        <a class="toolbar-icon github-link" href="https://github.com/JefferL05" aria-label="GitHub de Jefferson Lopes" title="GitHub">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.62 1.22 3.26.93.1-.72.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.55.23 2.7.11 2.98.73.79 1.16 1.79 1.16 3.02 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.2 11.2 0 0 0 12 .8Z"/></svg>
        </a>
        <Search />
        <button id="reading-toggle" class="reading-control" type="button" aria-label="Modo ilustrado" aria-pressed="false" title="Alternar entre leitura em texto e ilustrada">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m4 18 5-5 4 3 4-6 4 8"/></svg>
          <span id="reading-label">Texto</span>
        </button>
        <a class="toolbar-icon rss-link" href={url('/rss.xml')} aria-label="Acompanhar pelo RSS" title="RSS">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4a16 16 0 0 1 16 16M4 11a9 9 0 0 1 9 9"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
        </a>
        <span class="language-label" title="Conteúdo em português" lang="pt-BR">PT</span>
        <button id="theme-auto" class="auto-control" type="button" role="switch" aria-checked="false" aria-label="Seguir tema do sistema"><span class="switch-track" aria-hidden="true"></span><span>auto</span></button>
        <button
          id="theme-toggle"
          class="toolbar-icon"
          aria-label="Alternar tema"
        >
          <svg id="sun-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <svg id="moon-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        
        <button 
          id="mobile-menu-btn" 
          class="toolbar-icon"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
    
    <div id="mobile-menu" class="hidden pb-4">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'block py-2 text-sm font-medium transition-colors',
            currentPath === item.href 
              ? 'text-primary-600 dark:text-primary-400' 
              : 'text-gray-600 dark:text-gray-400'
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header { background: #faf9f6; color: #34312d; border-bottom: 1px solid #dedbd4; }
  :global(.dark) .site-header { background: #1b1916; color: #e7e2d6; border-color: #36332d; }
  .header-row, .header-tools, .desktop-links { display: flex; align-items: center; gap: 16px; }
  .header-row { min-height: 78px; }
  .header-tools { flex: 1; justify-content: flex-end; min-width: 0; gap: 12px; }
  .brand-link { display: flex; align-items: center; gap: 8px; font-weight: 700; white-space: nowrap; }
  .brand-name { display: none; }
  .reading-control { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 9px; border: 1px solid #8885; border-radius: 8px; font-size: 12px; white-space: nowrap; }
  .reading-control[aria-pressed='true'] { background: #567c6926; border-color: #719981; }
  .toolbar-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 44px; flex-shrink: 0; border-radius: 8px; }
  .toolbar-icon:hover { background: #8882; }
  .language-label { font-size: 13px; font-weight: 700; padding: 7px 2px; border-bottom: 1px solid currentColor; }
  .auto-control { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 12px; }
  .switch-track { width: 29px; height: 17px; border-radius: 20px; background: #7778; padding: 2px; }
  .switch-track::before { content: ''; display: block; width: 13px; height: 13px; background: white; border-radius: 50%; transition: transform .15s; }
  .auto-control[aria-checked='true'] .switch-track { background: #567c69; }
  .auto-control[aria-checked='true'] .switch-track::before { transform: translateX(12px); }
  a:focus-visible, button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (min-width: 1400px) { .brand-name { display: inline; } }
  @media (max-width: 900px) { .desktop-links { display: none; } }
  @media (max-width: 900px) {
    .header-row { display: grid; grid-template-columns: minmax(36px, 1fr) auto 58px 44px 44px; grid-template-rows: 44px 44px; align-items: center; gap: 10px 4px; padding: 12px 0; }
    .brand-link { grid-area: 1 / 1; align-self: center; justify-content: flex-start; margin: 0; height: 44px; }
    .header-tools { display: contents; }
    .reading-control { grid-area: 1 / 2; justify-self: end; padding: 0 8px; }
    .auto-control { grid-area: 1 / 3; justify-content: center; gap: 4px; }
    #theme-toggle { grid-area: 1 / 4; }
    #mobile-menu-btn { grid-area: 1 / 5; }
    .header-tools :global(.site-search) { grid-area: 2 / 1 / 3 / -1; align-self: stretch; justify-self: stretch; width: 100%; max-width: none; margin: 0; }
    .language-label { display: none; }
    .github-link, .rss-link { display: none; }
    .toolbar-icon { width: 44px; }
  }
</style>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const readingToggle = document.getElementById('reading-toggle');
  const readingLabel = document.getElementById('reading-label');
  function syncReading() {
    const illustrated = document.documentElement.dataset.reading === 'illustrated';
    readingToggle?.setAttribute('aria-pressed', String(illustrated));
    if (readingLabel) readingLabel.textContent = illustrated ? 'Ilustrado' : 'Texto';
  }
  syncReading();
  readingToggle?.addEventListener('click', () => {
    const mode = document.documentElement.dataset.reading === 'illustrated' ? 'text' : 'illustrated';
    document.documentElement.dataset.reading = mode;
    try { localStorage.setItem('reading-mode', mode); } catch {}
    syncReading();
  });
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const autoToggle = document.getElementById('theme-auto');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  let automatic = true;
  try { automatic = !['light', 'dark'].includes(localStorage.getItem('theme') ?? ''); } catch {}
  function syncAutomatic() { autoToggle?.setAttribute('aria-checked', String(automatic)); }
  
  function syncThemeIcon() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    } else {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    }
  }

  syncThemeIcon();
  syncAutomatic();
  systemTheme.addEventListener('change', () => {
    if (automatic) { document.documentElement.classList.toggle('dark', systemTheme.matches); syncThemeIcon(); }
  });
  autoToggle?.addEventListener('click', () => {
    automatic = !automatic;
    if (automatic) document.documentElement.classList.toggle('dark', systemTheme.matches);
    try {
      if (automatic) localStorage.removeItem('theme');
      else localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    } catch {}
    syncAutomatic(); syncThemeIcon();
  });
  themeToggle?.addEventListener('click', () => {
    automatic = false;
    syncAutomatic();
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
    syncThemeIcon();
  });
  
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    const expanded = !mobileMenu?.classList.contains('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(expanded));
    mobileMenuBtn.setAttribute('aria-label', expanded ? 'Fechar menu' : 'Abrir menu');
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      mobileMenu.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenuBtn?.setAttribute('aria-label', 'Abrir menu');
      mobileMenuBtn?.focus();
    }
  });
</script>
