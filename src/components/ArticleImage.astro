---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../utils/index';
interface Props { src: string; alt: string; class?: string; priority?: boolean; sizes?: string }
const { src, alt, class: className, priority = false, sizes = '(max-width: 768px) 100vw, 768px' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../public/images/posts/**/*.webp', { eager: true });
const metadata = Object.entries(images).find(([path]) => path.endsWith(`/public${src}`))?.[1].default;
const widths = metadata ? [...new Set([480, 768, 1280].map(width => Math.min(width, metadata.width)))] : [];
---
{metadata ? <Image src={metadata} alt={alt} widths={widths} sizes={sizes} class={className} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} /> : <img src={src.startsWith('http') ? src : url(src)} alt={alt} class={className} loading={priority ? 'eager' : 'lazy'} decoding="async" width="1200" height="675" />}
