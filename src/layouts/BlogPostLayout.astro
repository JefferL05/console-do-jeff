---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@components/TableOfContents.astro';
import { formatDate, slugify, url } from '@utils/index';
import CopyCode from '@components/CopyCode.astro';
import { getCollection } from 'astro:content';
import VisualGuide from '@components/VisualGuide.astro';
import { visualGuides } from '../data/visual-guides';
import ReadingTools from '@components/ReadingTools.astro';
import ArticleActions from '@components/ArticleActions.astro';
import ArticleImage from '@components/ArticleImage.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  tags: string[];
  image?: { url: string; alt: string };
  readingTime?: number;
  headings: Heading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  image,
  readingTime,
  headings
} = Astro.props;

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate && formatDate(updatedDate);
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const visualGuide = visualGuides[slug];
const related = (await getCollection('posts', ({ data }) => !data.draft))
  .filter(post => url(`/blog/${post.id}`).replace(/\/$/, '') !== Astro.url.pathname.replace(/\/$/, ''))
  .map(post => ({ post, score: (post.data.category === category ? 2 : 0) + post.data.tags.filter(tag => tags.includes(tag)).length }))
  .filter(item => item.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime() || a.post.id.localeCompare(b.post.id))
  .slice(0, 3);
---

<BaseLayout title={`${title} | Console do Jeff`} description={description} image={image?.url} article pubDate={pubDate}>
  <article class="blog-article max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <a href={url('/blog')} class="inline-flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Voltar para o blog
      </a>
      
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4 text-balance">
        {title}
      </h1>
      
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">
        {description}
      </p>
      
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        </span>
        
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          {author}
        </span>
        
        <a href={url(`/categories/${slugify(category)}`)} class="flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          {category}
        </a>
        
        {readingTime && (
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readingTime} min de leitura
          </span>
        )}
      </div>
      
      {updatedDate && (
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
          Atualizado em {formattedUpdatedDate}
        </p>
      )}
    </div>
    
    {image && (
      <figure class="mb-8">
        <ArticleImage
          src={image.url}
          alt={image.alt}
          class="w-full h-auto rounded-xl shadow-lg"
          priority
          sizes="(max-width: 1152px) 100vw, 1088px"
        />
        <figcaption class="text-center text-sm text-gray-500 dark:text-gray-400 mt-2">
          {image.alt}
        </figcaption>
      </figure>
    )}
    
    <ReadingTools headings={headings} />
    {visualGuide && <VisualGuide guide={visualGuide} />}
    <div class="lg:flex lg:gap-12">
      <aside class="hidden lg:block">
        <TableOfContents headings={headings} />
      </aside>
      
      <div class="flex-1 min-w-0">
        <div class="article-body prose prose-lg dark:prose-invert max-w-none">
          <slot />
        </div>
        <ArticleActions title={title} />
        {related.length > 0 && <section class="mt-10" aria-labelledby="related-title">
          <h2 id="related-title" class="text-2xl font-bold mb-4">Continue a leitura</h2>
          <ul class="grid gap-4">
            {related.map(({ post }) => <li class="rounded-xl border border-gray-200 dark:border-gray-700 p-4">
              <a class="font-semibold text-primary-600 dark:text-primary-400 hover:underline" href={url(`/blog/${post.id}`)}>{post.data.title}</a>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">{post.data.description}</p>
            </li>)}
          </ul>
        </section>}
        <p class="mt-6"><a class="underline" href={url('/rss.xml')}>Acompanhe novos artigos pelo RSS</a></p>
        
        <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <a
                href={url(`/tags/${slugify(tag)}`)}
                class="px-3 py-1 text-sm bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </article>
  <CopyCode />
</BaseLayout>

<style is:global>
  [data-reading='illustrated'] .blog-article { counter-reset: visual-section; }
  [data-reading='illustrated'] .article-body > h2 {
    counter-increment: visual-section;
    border-top: 1px solid #92939b55;
    padding-top: 2rem;
    margin-top: 3rem;
    letter-spacing: -.025em;
    scroll-margin-top: 160px;
  }
  [data-reading='illustrated'] .article-body > h2::before {
    content: counter(visual-section, decimal-leading-zero) ' /';
    display: block; font: 600 13px monospace; letter-spacing: .1em;
    color: #0f766e; margin-bottom: .8rem;
  }
  .dark[data-reading='illustrated'] .article-body > h2::before { color: #7ad6c9; }
  [data-reading='illustrated'] .article-body blockquote { border-radius: 0 16px 16px 0; background: #0f766e0c; padding: 1rem 1.5rem; }
  [data-reading='illustrated'] .article-body img { border: 1px solid #92939b44; border-radius: 16px; }
  [data-reading='illustrated'] .article-body > ul { padding: 1.3rem 1.3rem 1.3rem 2.7rem; background: #8585900a; border: 1px solid #92939b33; border-radius: 16px; }
</style>
