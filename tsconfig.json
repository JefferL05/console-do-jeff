{
  "extends": "astro/tsconfigs/strict",
  "exclude": ["dist", "artifacts", "node_modules", "mobile/node_modules", "mobile/www", "mobile/android"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@utils/*": ["src/utils/*"]
    },
    "ignoreDeprecations": "6.0"
  }
}
